{
  // Fareit on Cloudflare Workers: static PWA in ./public, OneMap proxy in worker/index.js
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fareit",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Shared training pool every phone contributes to (created automatically on deploy if it doesn't exist)
  "d1_databases": [{ "binding": "DB", "database_name": "fareit-pool" }],
  "observability": { "enabled": true }
  // Secrets (dashboard > Variables and Secrets, or `npx wrangler secret put NAME`):
  //   ONEMAP_EMAIL, ONEMAP_PASSWORD   free account from onemap.gov.sg, used for driving routes
  //   HASH_SALT (optional)            any random text; salts the hashed IP used for rate limiting
  //   APP_KEY (optional)              leave unset for an open, collective app
}
